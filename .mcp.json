{
  "command-center": {
    "command": "node",
    "args": ["/media/islamux/Variety/JavaScriptProjects/bassaer/command-center-mcp/dist/index.js"],
    "env": {
      "PROJECT_ROOT": "/media/islamux/Variety/JavaScriptProjects/bassaer"
    },
    "agents": {
      "orchestrator": {
        "name": "Basaar Orchestrator",
        "type": "orchestrator",
        "color": "#585CF0",
        "permissions": ["READ", "WRITE", "EXECUTE", "DISPATCH"]
      },
      "explorer": {
        "name": "Explorer Agent",
        "type": "sub-agent",
        "parent_id": "orchestrator",
        "color": "#8286FF",
        "permissions": ["READ", "WRITE"]
      },
      "researcher": {
        "name": "Researcher Agent",
        "type": "sub-agent",
        "parent_id": "orchestrator",
        "color": "#6366F1",
        "permissions": ["READ", "WRITE"]
      },
      "post-build-auditor": {
        "name": "Post-Build Auditor",
        "type": "sub-agent",
        "parent_id": "orchestrator",
        "color": "#22c55e",
        "permissions": ["READ", "WRITE"]
      },
      "arabic-specialist": {
        "name": "Arabic Content Specialist",
        "type": "sub-agent",
        "parent_id": "orchestrator",
        "color": "#f59e0b",
        "permissions": ["READ", "WRITE"]
      },
      "nextjs-specialist": {
        "name": "Next.js Specialist",
        "type": "sub-agent",
        "parent_id": "orchestrator",
        "color": "#14B8A6",
        "permissions": ["READ", "WRITE"]
      }
    },
    "workflow": {
      "task_lifecycle": {
        "states": ["todo", "in_progress", "review", "done", "blocked"],
        "transitions": {
          "start_task": {
            "from": "todo",
            "to": "in_progress"
          },
          "complete_task": {
            "from": "in_progress",
            "to": "review"
          },
          "approve_task": {
            "from": "review",
            "to": "done"
          },
          "reject_task": {
            "from": "review",
            "to": "in_progress"
          },
          "block_task": {
            "from": ["todo", "in_progress", "review"],
            "to": "blocked"
          },
          "unblock_task": {
            "from": "blocked",
            "to": ["todo", "in_progress"]
          }
        }
      },
      "prepare_phase": {
        "steps": [
          "get_task_context",
          "dispatch_explorer",
          "dispatch_researcher",
          "enrich_task"
        ]
      },
      "start_phase": {
        "steps": [
          "start_task",
          "get_task_context",
          "implement",
          "validate",
          "dispatch_auditor",
          "complete_task"
        ]
      }
    }
  }
}
